{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,

    // Some modules of the page are JavaScript with their types in JSDoc,
    // because the gate runs them under a bare node to assert what a person
    // reads rather than the source that would produce it (ADR-0009 d.3).
    // `tests/ui/test_decoder.py` lists them.
    // They are checked here under the same strictness as everything else
    // rather than taken on trust.
    "allowJs": true,
    "checkJs": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "useDefineForClassFields": false,
    "noEmit": true
  },
  // The page, the two configs and the checks that mount a component. The
  // checks are in it for the reason the JavaScript modules above are: they are
  // read by a person as the claim about what the page draws, and a claim that
  // does not type-check is a claim about nothing (`ui/test/mounted.ts`, #126).
  "include": ["src", "test", "vite.config.ts", "vitest.config.ts"]
}
